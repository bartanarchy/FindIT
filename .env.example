DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=FindIT
DB_USER=postgres
DB_PASS=

APP_ENC_KEY=

PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
REMOTE_DRIVER=folder
REMOTE_FOLDER_PATH=D:\FindIT_Backup_Salinan

; ---- Restore ---------------------------------------------------------------

; Throw-away database for restore tests.
RESTORE_TEST_DB=findit_restore_test

; Allow the Restore button on the admin page.
RESTORE_WEB_ENABLED=true

BACKUP_MIN_INTERVAL_HOURS=

; ---- App & Mail (Password Reset) -------------------------------------------
; Full base URL to the public/ folder (no trailing slash).
APP_URL=http://localhost/FindIT/public

; Local dev with Laragon Mailpit/MailHog: host=127.0.0.1, port=1025, encryption=
; Real SMTP (e.g. Gmail App Password): host=smtp.gmail.com, port=587, encryption=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@findit.local
MAIL_FROM_NAME=FindIT