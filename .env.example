DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=FindIT
DB_USER=postgres
DB_PASS=    

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# 32-byte secret key (base64). Generate with: php scripts/generate-key.php --write
# Encrypts sensitive database columns and the backup. Never commit it, and keep an
# offline copy: losing this key means the encrypted data cannot be recovered.
APP_ENC_KEY=

# Optional: folder for encrypted backups (use another drive/synced folder for safety).
# Leave empty to use storage/backup inside the project.
BACKUP_PATH=
