# ---- Database (the web app) ------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=FindIT
DB_USER=postgres
DB_PASS=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Encryption key --------------------------------------------------------
# 32-byte secret (base64). Generate with: php scripts/generate-key.php --write
# Never commit it. Keep an offline copy: without it encrypted data cannot be read.
APP_ENC_KEY=

# ---- Backup ----------------------------------------------------------------

PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
REMOTE_DRIVER=folder
REMOTE_FOLDER_PATH=D:\FindIT_Backup_Salinan

# ---- Restore ---------------------------------------------------------------
# Throw-away database for restore tests. The name must contain "test".
RESTORE_TEST_DB=findit_restore_test
# Allow the "Restore" button on the admin page. Keep false unless you need it;
# php scripts/restore.php always works.
RESTORE_WEB_ENABLED=true
