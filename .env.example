# ---- Database (the web app) ------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=FindIT
DB_USER=postgres
DB_PASS=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Encryption key --------------------------------------------------------
# 32-byte secret (base64). Generate with: php scripts/generate-key.php --write
# Never commit it. Keep an offline copy: without it encrypted data cannot be read.
APP_ENC_KEY=

# ---- Backup ----------------------------------------------------------------
# Folder for backups. MUST be outside the website folder (never reachable by URL).
# Windows default when empty: C:\FindIT_Backups
BACKUP_DIR=
# Folder that holds pg_dump / pg_restore / psql, only if they are not found automatically.
# Example: C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=
APP_TIMEZONE=Asia/Jakarta

# How many backups to keep (older ones are deleted only after a newer valid one exists).
BACKUP_KEEP_DAILY_DAYS=7
BACKUP_KEEP_WEEKLY_WEEKS=4
# A scheduled run is skipped when a good backup is newer than this many hours.
BACKUP_MIN_INTERVAL_HOURS=12

# Optional least-privilege database accounts (see database/hardening/least-privilege.sql).
# Empty = DB_USER / DB_PASS are used.
BACKUP_DB_USER=
BACKUP_DB_PASS=
RESTORE_DB_USER=
RESTORE_DB_PASS=
# Maintenance database used when restoring (the real DB may not exist).
MAINTENANCE_DB=postgres

# ---- Second copy of every backup (REMOTE_DRIVER = none | folder | sftp) ----
REMOTE_DRIVER=none
# folder: another drive, USB, NAS or cloud-synced folder (must differ from BACKUP_DIR)
REMOTE_FOLDER_PATH=
# sftp: needs OpenSSH (ssh/scp) and key login. No password is stored here.
REMOTE_SFTP_HOST=
REMOTE_SFTP_PORT=22
REMOTE_SFTP_USER=
REMOTE_SFTP_DIR=
REMOTE_SFTP_KEY=
REMOTE_SFTP_KNOWN_HOSTS=
# Apply the retention rules on the remote copy too.
REMOTE_RETENTION_BY_APP=true

# ---- Restore ---------------------------------------------------------------
# Throw-away database for restore tests. The name must contain "test".
RESTORE_TEST_DB=findit_restore_test
# Allow the "Restore" button on the admin page. Keep false unless you need it;
# php scripts/restore.php always works.
RESTORE_WEB_ENABLED=false
